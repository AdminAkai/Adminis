{
  "name": "adminis-construction",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prepare": "husky install",
    "generate": "graphql-codegen",
    "test": "jest --setupFilesAfterEnv --maxConcurrency=2 --testPathPattern=src/",
    "playwright": "npx playwright test"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@marsidev/react-turnstile": "^1.6.0",
    "@redux-saga/types": "^1.4.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/react-redux": "^7.1.34",
    "dotenv": "^16.6.1",
    "graphql": "^16.14.2",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-compiler-runtime": "19.0.0-beta-ebf51a3-20250411",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "react-test-renderer": "^19.2.8",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "19.0.0-beta-ebf51a3-20250411",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.0.0-beta-ebf51a3-20250411",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-svgr": "^4.5.0"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "roots": [
      "<rootDir>"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "verbose": true,
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.config.ts"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules"
    ]
  },
  "lint-staged": {
    "*.{js,css,ts,tsx,jsx}": [
      "prettier . --write"
    ]
  }
}
